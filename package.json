{
    "name":  "huepot",
    "version":  "1.3.14",
    "private":  true,
    "scripts":  {
                    "dev":  "next dev",
                    "build":  "prisma generate \u0026\u0026 next build --webpack",
                    "start":  "next start",
                    "lint":  "eslint",
                    "postinstall":  "prisma generate",
                    "db:push":  "prisma db push",
                    "db:studio":  "prisma studio",
                    "coin:compile":  "hardhat compile --config hardhat.config.cjs",
                    "coin:test":  "hardhat test --config hardhat.config.cjs",
                    "coin:deploy:testnet":  "hardhat run scripts/deploy-coin.cjs --config hardhat.config.cjs --network bscTestnet",
                    "coin:deploy:mainnet":  "hardhat run scripts/deploy-coin.cjs --config hardhat.config.cjs --network bsc",
                    "check:encoding":  "node scripts/check-encoding.mjs"
                },
    "dependencies":  {
                         "@prisma/client":  "^6.19.0",
                         "ethers":  "^6.17.0",
                         "next":  "16.3.1",
                         "react":  "19.2.8",
                         "react-dom":  "19.2.8",
                         "three":  "^0.185.1",
                         "tweetnacl":  "^1.0.3"
                     },
    "devDependencies":  {
                            "@nomicfoundation/hardhat-ethers":  "^3.1.3",
                            "@tailwindcss/postcss":  "^4",
                            "@types/node":  "^20",
                            "@types/react":  "^19",
                            "@types/react-dom":  "^19",
                            "@types/three":  "^0.185.4",
                            "dotenv":  "^17.4.2",
                            "eslint":  "^9",
                            "eslint-config-next":  "16.3.1",
                            "hardhat":  "^2.29.1",
                            "prisma":  "^6.19.0",
                            "tailwindcss":  "^4",
                            "typescript":  "^5"
                        }
}